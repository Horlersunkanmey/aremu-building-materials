# ============================================================================
# AREMU BUILDING AND CONSTRUCTION MATERIALS - ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env.local for local development, or configure these keys
# in your Vercel Project Settings -> Environment Variables.
# NEVER commit .env.local or real secret keys to Git.
# ============================================================================

# 1. Public Site URL (Change to your production domain once deployed on Vercel)
NEXT_PUBLIC_SITE_URL=https://aremu-building-materials.vercel.app

# 2. Supabase Project Connection (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 3. Supabase Service Role Key (SERVER-ONLY - Never expose to client code)
# Used only for privileged server-side seeding or admin provisioning
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. Supabase Storage Bucket Name for Product, Property & Service Images
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=aremu-media

# 5. Optional Initial Admin Setup Token (For first-time admin provisioning via API or CLI)
ADMIN_SETUP_SECRET=replace-with-a-strong-random-setup-secret
